generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        String    @id @default(uuid())
  code      RoleCode  @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  users     User[]

  @@map("roles")
}

model Emotion {
  id        String    @id @default(uuid())
  code      String    @unique
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  parent    Emotion?  @relation("EmotionTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Emotion[] @relation("EmotionTree")
  journals  Journal[]

  @@index([parentId])
  @@map("emotions")
}

model Organization {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  website     String?
  logoUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  users       User[]

  @@map("organizations")
}

model User {
  id                     String             @id @default(uuid())
  email                  String             @unique
  passwordHash           String
  username               String?            @unique
  firstName              String
  lastName               String
  phone                  String?
  bio                    String?
  profileImageUrl        String?
  preferredLanguage      String             @default("en")
  status                 UserStatus         @default(ACTIVE)
  emailVerifiedAt        DateTime?
  lastLoginAt            DateTime?
  roleId                 String
  organizationId         String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?
  clientRelationships    CareRelationship[] @relation("ClientRelationships")
  counselorRelationships CareRelationship[] @relation("CounselorRelationships")
  counselorNotesReceived CounselorNote[]    @relation("ReceivedNotes")
  counselorNotesWritten  CounselorNote[]    @relation("WrittenNotes")
  journals               Journal[]
  refreshTokens          RefreshToken[]
  organization           Organization?      @relation(fields: [organizationId], references: [id])
  role                   Role               @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([organizationId])
  @@index([status])
  @@map("users")
}

model CareRelationship {
  id          String                 @id @default(uuid())
  counselorId String
  clientId    String
  status      CareRelationshipStatus @default(PENDING)
  requestedAt DateTime               @default(now())
  respondedAt DateTime?
  endedAt     DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  deletedAt   DateTime?
  client      User                   @relation("ClientRelationships", fields: [clientId], references: [id], onDelete: Cascade)
  counselor   User                   @relation("CounselorRelationships", fields: [counselorId], references: [id], onDelete: Cascade)

  @@unique([counselorId, clientId])
  @@index([counselorId])
  @@index([clientId])
  @@index([status])
  @@map("care_relationships")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Journal {
  id               String            @id @default(uuid())
  userId           String
  entryType        JournalEntryType
  primaryEmotionId String?
  intensityBefore  Int?
  intensityAfter   Int?
  visibility       JournalVisibility @default(PRIVATE)
  content          Json              @default("{}")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  counselorNotes   CounselorNote[]
  primaryEmotion   Emotion?          @relation(fields: [primaryEmotionId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([primaryEmotionId])
  @@index([entryType])
  @@index([createdAt])
  @@map("journals")
}

model CounselorNote {
  id          String    @id @default(uuid())
  counselorId String
  clientId    String
  journalId   String?
  note        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  client      User      @relation("ReceivedNotes", fields: [clientId], references: [id], onDelete: Cascade)
  counselor   User      @relation("WrittenNotes", fields: [counselorId], references: [id], onDelete: Cascade)
  journal     Journal?  @relation(fields: [journalId], references: [id])

  @@index([counselorId])
  @@index([clientId])
  @@index([journalId])
  @@index([createdAt])
  @@map("counselor_notes")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleCode {
  ADMIN
  CLIENT
  COUNSELOR
}

enum CareRelationshipStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
}

enum JournalEntryType {
  THOUGHT_RECORD
  PANIC_LOG
  GRATITUDE
  MOOD_CHECK
  FREE_JOURNAL
}

enum JournalVisibility {
  PRIVATE
  COUNSELOR
  ORGANIZATION
  PUBLIC
}
